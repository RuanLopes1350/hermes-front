# URL base da Hermes API (obrigatório)
NEXT_PUBLIC_API_URL = http://localhost:3001

# URL pública onde este frontend é servido (obrigatório para SEO/OpenGraph).
# Em produção, use o domínio real (ex: https://app.seudominio.com) — é usada para
# montar as URLs absolutas da imagem de preview (Open Graph/Twitter Card) e do favicon.
# IMPORTANTE: como é uma variável NEXT_PUBLIC_*, ela é embutida no bundle em tempo de
# BUILD. Se buildar via Docker, passe também como --build-arg NEXT_PUBLIC_APP_URL=...
NEXT_PUBLIC_APP_URL = http://localhost:3000